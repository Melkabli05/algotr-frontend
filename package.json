{
  "name": "algotr-terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "types": "openapi-typescript http://localhost:8000/openapi.json -o src/api/schema.d.ts",
    "check": "biome check src && tsc --noEmit && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@blueprintjs/core": "6.21.0",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.4.0",
    "@tanstack/react-query": "5.104.5",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "klinecharts": "10.1.0",
    "lightweight-charts": "5.2.1",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
