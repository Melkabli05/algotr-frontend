# Served by nginx:alpine, which renders this template with envsubst on
# start. API_UPSTREAM is the backend address (api:8000 in compose).
# Mirrors the vite dev proxy: everything except /ui/ goes to the API.
server {
    listen 80;
    server_name _;

    location = / {
        return 302 /ui/;
    }

    location = /ui {
        return 301 /ui/;
    }

    location /ui/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /ui/index.html;
    }

    location /stream {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
